# ── Kaggle API ────────────────────────────────────────────────────────────────
# Obtém em kaggle.com → ícone perfil → Settings → API → Create New Token
KAGGLE_USERNAME=seu_usuario_kaggle
KAGGLE_KEY=sua_chave_kaggle

# ── Roboflow API ───────────────────────────────────────────────────────────────
# Obtém em app.roboflow.com → Workspace Settings → API Keys → Private API Key
ROBOFLOW_API_KEY=sua_chave_roboflow

# ── Modo de operação ─────────────────────────────────────────────────────────
# true  → usa pesos ImageNet (nenhum .pth necessário); resultados ilustrativos
# false → exige .pth treinados em weights/; resultados reais
DEMO_MODE=true

# ── Base de dados ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./fitovision.db

# ── Modelos ───────────────────────────────────────────────────────────────────
WEIGHTS_DIR=./weights
NUM_CLASSES=6

# ── API ───────────────────────────────────────────────────────────────────────
# Origens permitidas pelo CORS (separar múltiplas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Tamanho máximo de upload em bytes (padrão: 10 MB)
MAX_UPLOAD_BYTES=10485760

# Limiar mínimo de confiança (0.0 = desactivado; ex.: 0.3 rejeita < 30%)
CONFIDENCE_THRESHOLD=0.0
